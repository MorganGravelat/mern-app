# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB.
# From your own computer (Compass, npm run dev): mongodb://localhost:27017/WorkOrderDB
# From inside Docker Compose (once the API container is added): mongodb://mongodb:27017/WorkOrderDB
MONGODB_URI=mongodb://localhost:27017/WorkOrderDB

# Port for the Node API server (later)
PORT=5000
