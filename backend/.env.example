# Copy this file to .env and fill in the values. Never commit .env.

# --- Database ---
# Your computer (Compass, npm run dev): mongodb://localhost:27017/WorkOrderDB
# Server with Atlas: the "Drivers" connection string from Atlas, with /WorkOrderDB before the "?", e.g.
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/WorkOrderDB?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/WorkOrderDB

# Port for the Node API server
PORT=5000

# --- Login tokens ---
# Two different long random strings. Generate each with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- URLs ---
# Where the API is reachable; links in verification emails start with this.
#   Local: http://localhost:5000   Server: http://YOUR_DROPLET_IP or https://api.yourdomain.com
PUBLIC_URL=http://localhost:5000
# Where the web app is (password reset links open APP_URL/reset-password). Same as PUBLIC_URL for now.
APP_URL=http://localhost:5000
# Browser origins allowed to call the API, comma-separated (the web app, SwaggerHub). Leave empty for now.
CORS_ORIGINS=

# --- Email (Resend) ---
# Leave empty and emails are printed in the API log instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Work Orders <onboarding@resend.dev>

# --- Server only (docker-compose.prod.yml) ---
# Your domain for automatic HTTPS (e.g. api.yourdomain.com), or :80 for plain HTTP by IP address.
SITE_ADDRESS=:80
